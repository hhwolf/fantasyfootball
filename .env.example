# --- required ---
APP_PASSWORD=pick-a-password
SESSION_SECRET=replace-with-32-plus-random-chars
# 32 random bytes, base64:  openssl rand -base64 32
ENCRYPTION_KEY=
# protects /api/cron/daily on Vercel:  openssl rand -hex 24
CRON_SECRET=

# --- database (Neon / Postgres). Optional: without it the app runs read-only from the ESPN_* vars below ---
DATABASE_URL=

# --- fallback league config when no database is configured ---
ESPN_LEAGUE_ID=
ESPN_SEASON=2026
ESPN_TEAM_ID=
# private leagues only
ESPN_S2=
SWID=
